# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Public URL of this API (used to build links to uploaded files)
PUBLIC_API_URL=http://localhost:5000
# Frontend URL (used in email links)
APP_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the app (for correct client IPs)
TRUST_PROXY=0
# LOG_LEVEL=info

# --- Database -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/contacthub

# --- Auth -----------------------------------------------------------------
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# lax | strict | none ("none" requires HTTPS)
COOKIE_SAMESITE=lax
REQUIRE_EMAIL_VERIFICATION=false
# Enables POST /api/v1/auth/google
GOOGLE_CLIENT_ID=

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Redis (optional) -----------------------------------------------------
# When set: BullMQ job queue, shared rate limits, single-run cron jobs.
# REDIS_URL=redis://127.0.0.1:6379
# Set to false when running `npm run worker` as a separate process
RUN_WORKER_IN_API=true

# --- Email (optional) -----------------------------------------------------
# Without SMTP_HOST, emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ContactHub <no-reply@example.com>"

# --- File storage ---------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# For s3 (credentials via the usual AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
S3_BUCKET=
S3_REGION=
# For S3-compatible services such as MinIO or Cloudflare R2
S3_ENDPOINT=
S3_PUBLIC_URL=

# --- Scheduled jobs -------------------------------------------------------
ENABLE_SCHEDULER=true
CRON_TIMEZONE=UTC
BIRTHDAY_REMINDER_CRON="0 8 * * *"
TRASH_PURGE_CRON="30 3 * * *"
TRASH_RETENTION_DAYS=30

# --- Observability --------------------------------------------------------
ENABLE_METRICS=true
ENABLE_API_DOCS=true
